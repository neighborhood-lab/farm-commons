# Farm Commons Backend Environment Variables
# Copy this file to .env and fill in your values

# Server Configuration
NODE_ENV=development
PORT=3001
LOG_LEVEL=info

# CORS Configuration
CORS_ORIGIN=http://localhost:5173

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Database Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/farm_commons
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10

# Redis Configuration (for sessions, rate limiting, caching)
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=

# JWT Authentication
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=1d
JWT_REFRESH_EXPIRES_IN=7d

# Email Service Configuration
EMAIL_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=noreply@farmcommons.org

# File Upload Configuration (for future use)
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760

# Feature Flags
ENABLE_REGISTRATION=true
ENABLE_API_DOCS=true
