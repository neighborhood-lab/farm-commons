{
  "name": "@farm-commons/mobile",
  "version": "0.1.0",
  "private": true,
  "description": "Farm Commons mobile app (React Native + Expo)",
  "main": "expo-router",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "echo 'Mobile package has no src directory yet - skipping lint'",
    "clean": "rm -rf .expo node_modules"
  },
  "dependencies": {
    "@farm-commons/shared": "workspace:*",
    "expo": "~54.0.0",
    "expo-router": "^4.0.0",
    "react": "^19.0.0",
    "react-native": "0.82.0",
    "@react-navigation/native": "^7.0.0",
    "@react-navigation/native-stack": "^7.0.0",
    "@react-native-async-storage/async-storage": "^2.1.0",
    "react-native-paper": "^5.12.5",
    "@tanstack/react-query": "^5.90.0",
    "zustand": "^5.0.3",
    "@nozbe/watermelondb": "^0.25.0",
    "expo-location": "~18.0.0",
    "expo-camera": "~16.0.0",
    "expo-notifications": "~0.30.0",
    "expo-local-authentication": "~15.0.0",
    "react-native-maps": "1.20.0",
    "date-fns": "^4.1.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.7",
    "@babel/core": "^7.26.0",
    "typescript": "^5.9.0",
    "vitest": "^2.1.8",
    "@vitest/ui": "^2.1.8"
  }
}
