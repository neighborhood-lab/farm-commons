# Database Configuration
DATABASE_URL=postgresql://postgres:password@localhost:5432/farm_commons
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=farm_commons
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password

# Redis Configuration
REDIS_URL=redis://localhost:6379

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d

# Server Configuration
NODE_ENV=development
PORT=3001
FRONTEND_URL=http://localhost:5173

# Logging
LOG_LEVEL=debug

# Security
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# CORS
CORS_ORIGIN=http://localhost:5173

# Monitoring & Observability
# Sentry - Error tracking and performance monitoring
# Get your DSN from https://sentry.io after creating a project
SENTRY_DSN=
SENTRY_ENVIRONMENT=development

# Prometheus - Metrics collection
# Metrics are exposed at /metrics endpoint
ENABLE_METRICS=true

# Sample rates for production (0.0 to 1.0)
# Use lower values in production to control costs
# Development: use 1.0 for full visibility
SENTRY_TRACES_SAMPLE_RATE=1.0
SENTRY_PROFILES_SAMPLE_RATE=1.0
