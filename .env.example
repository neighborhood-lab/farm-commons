# Database Configuration
DATABASE_URL=postgresql://postgres:password@localhost:5432/farm_commons
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=farm_commons
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password

# Redis Configuration
REDIS_URL=redis://localhost:6379

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d

# Server Configuration
NODE_ENV=development
PORT=3001
FRONTEND_URL=http://localhost:5173

# Logging
LOG_LEVEL=debug

# Security
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# CORS
CORS_ORIGIN=http://localhost:5173

# Monitoring (Optional)
SENTRY_DSN=

# File Upload Configuration
STORAGE_TYPE=local # Options: local, s3
BACKEND_URL=http://localhost:3001

# S3 Configuration (Optional - only needed if STORAGE_TYPE=s3)
S3_BUCKET=
S3_REGION=us-east-1
S3_ENDPOINT= # Optional - for S3-compatible services like MinIO, DigitalOcean Spaces
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
